---
interface Props {
  code: string;
  lang?: string;
  /** Optional caption rendered above the block, e.g. the command's role. */
  label?: string;
  /** Wrap long lines (an argv) instead of scrolling. */
  wrap?: boolean;
}
const { code, lang = 'sh', label, wrap = false } = Astro.props;
// `cb-wrap` is the layout hook prose.css uses for vertical rhythm.
---

<div class="cb-wrap min-w-0">
  {
    /* Mono like an eyebrow, but not uppercased: labels can hold a file path. */
    label && <p class="mb-2 font-mono text-[0.75rem] text-[var(--color-ink-soft)]">{label}</p>
  }
  <div class="relative group">
    <pre
      class:list={[
        'bg-[var(--color-ink)] text-[var(--color-paper)] px-4 py-3 overflow-x-auto text-[0.85rem] leading-relaxed w-full',
        wrap && 'whitespace-pre-wrap [overflow-wrap:anywhere]'
      ]}><code data-lang={lang}>{code}</code></pre>
    <button
      type="button"
      class="absolute top-2 right-2 text-xs px-2 py-1 bg-[var(--color-paper)] text-[var(--color-ink)] border border-[var(--color-line)] font-mono opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity"
      data-copy={code}
      aria-label="Copy code to clipboard"
    >
      Copy
    </button>
  </div>
</div>

<style>
  /* Touch screens have no hover: keep the button in sight, in its own strip
   * above the first line so it never covers code. */
  @media (hover: none) {
    [data-copy] {
      opacity: 0.75;
    }
    pre {
      padding-top: 2.5rem;
    }
  }
</style>

<script>
  // One delegated listener for every CodeBlock on the page. The only runtime
  // JavaScript the site ships.
  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>('button[data-copy]');
    if (!btn) return;
    const text = btn.dataset.copy ?? '';
    const original = btn.textContent;
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Press Ctrl+C';
    }
    setTimeout(() => {
      btn.textContent = original;
    }, 1200);
  });
</script>
