---
interface Props {
  code: string;
  lang?: string;
  /** Optional caption rendered above the block, e.g. the command's role. */
  label?: string;
  /** Wrap long lines (an argv) instead of scrolling. */
  wrap?: boolean;
  /** Type the lines in when the block scrolls into view (src/scripts/motion.ts). */
  typing?: boolean;
}
const { code, lang = 'sh', label, wrap = false, typing = false } = Astro.props;
// `cb-wrap` is the layout hook prose.css uses for vertical rhythm.
---

<div class="cb-wrap min-w-0">
  <div class="mb-2 flex min-w-0 items-center gap-3">
    {
      label && (
        <p class="cb-label min-w-0 font-mono text-xs [overflow-wrap:anywhere]">
          {label}
        </p>
      )
    }
    <button
      type="button"
      class="ml-auto min-h-11 shrink-0 border border-[var(--color-line-strong)] px-3 font-mono text-xs text-[var(--color-cream)]"
      data-copy={code}
      aria-label={label ? `Copy: ${label}` : 'Copy code to clipboard'}>Copy</button
    >
  </div>
  <div class="relative group" data-typing={typing ? '' : undefined}>
    <pre
      tabindex={wrap ? undefined : 0}
      role={wrap ? undefined : 'region'}
      aria-label={wrap ? undefined : (label ?? 'Code example')}
      class:list={[
        'bg-[var(--color-coal-deep)] text-[var(--color-cream)] border border-[var(--color-line)] px-4 py-3.5 overflow-x-auto text-[0.84rem] leading-relaxed w-full',
        wrap && 'whitespace-pre-wrap [overflow-wrap:anywhere]'
      ]}><code data-lang={lang}>{typing ? code.split('\n').map((l) => <span class="ty-line block"><span class="ty-tx">{l}</span></span>) : code}</code></pre>
  </div>
  <p class="text-xs empty:m-0" role="status" data-copy-status></p>
</div>

<script>
  const timers = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();
  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>('button[data-copy]');
    if (!button) return;
    const status = button.closest('.cb-wrap')?.querySelector('[data-copy-status]');
    const previous = timers.get(button);
    if (previous) clearTimeout(previous);
    if (status) status.textContent = '';
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copied';
      if (status) status.textContent = 'Code copied to the clipboard.';
    } catch {
      button.textContent = 'Copy';
      if (status)
        status.textContent = 'Clipboard unavailable. Select the code and copy it manually.';
      return;
    }
    timers.set(
      button,
      setTimeout(() => {
        button.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2200)
    );
  });
</script>
