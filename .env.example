# Analytics (optional — leave empty to disable).
#
# Provider: Umami. No cookies, no fingerprinting, no cross-site tracking; see
# /privacy on the site.
#
# The website id is in Umami → Settings → Websites → the site → Edit
# (`data-website-id="..."` in the tracking code). PUBLIC_-prefixed because
# Astro requires that for values rendered to the client; the id identifies
# the site and is not a secret.
PUBLIC_UMAMI_WEBSITE_ID=
# Only for a self-hosted Umami: the URL of its script.js. Empty means Umami
# Cloud (https://cloud.umami.is/script.js).
PUBLIC_UMAMI_SRC=
