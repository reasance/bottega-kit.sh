---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import UmamiAnalytics from '../components/UmamiAnalytics.astro';
import kit from '../data/kit.json';
import copy from '../data/copy.json';

const SITE_DESCRIPTION = copy.meta.description;

interface PageMeta {
  title?: string;
  description?: string;
  path?: string;
  /** When true, applies `.doc` prose styles to <main> and loads prose.css. */
  doc?: boolean;
  /** When true, the page animates (src/scripts/motion.ts); see `.motion` in global.css. */
  motion?: boolean;
}

interface Props extends PageMeta {
  /** Astro injects Markdown frontmatter here when this is used as `layout:`. */
  frontmatter?: PageMeta;
}

const merged: PageMeta = { ...Astro.props, ...Astro.props.frontmatter };
const {
  title = copy.meta.title,
  description = SITE_DESCRIPTION,
  path = '/',
  doc: isDoc = false,
  motion = false
} = merged;

const siteOrigin = Astro.site ?? new URL('https://bottega-kit.sh');
const canonical = new URL(
  path === '/' || path.endsWith('/') ? path : path + '/',
  siteOrigin
).toString();
const ogImage = new URL('/og-image.png', siteOrigin).toString();
const ogAlt =
  'bottega-kit. You approve the plan. The agents do the rounds. Six coding-agent CLIs, one role each, in a git worktree, with a receipt for every dispatch.';

const nav = [
  { href: '/#commands', label: 'Commands' },
  { href: '/#loop', label: 'The loop' },
  { href: '/#roles', label: 'Roles' },
  { href: '/docs/', label: 'Docs' },
  { href: 'https://github.com/reasance/bottega-kit', label: 'GitHub' }
];
const navLink = 'hover:text-[var(--color-you)] transition-colors';

// Runs before paint, so nothing shows in its final place and then jumps back
// to start its entrance. If motion.ts has not run within three seconds the
// class comes off and the page is simply still.
const motionBoot = `if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const root = document.documentElement;
  root.classList.add('motion');
  setTimeout(() => window.__motion || root.classList.remove('motion'), 3000);
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="matteoscurati" />
    <meta name="theme-color" content="#161210" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f3ea" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {isDoc && <link rel="stylesheet" href="/prose.css" />}
    {motion && <script is:inline set:html={motionBoot} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="bottega-kit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'bottega-kit',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'macOS, Linux',
        description: SITE_DESCRIPTION,
        softwareVersion: kit.version,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        url: siteOrigin.href.replace(/\/$/, ''),
        license: 'https://opensource.org/licenses/MIT'
      })}
    />

    <UmamiAnalytics />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-[var(--color-cream)] focus:text-[var(--color-soot)]"
      >Skip to content</a
    >
    <header class="border-b border-[var(--color-line)]">
      <nav
        class="max-w-[76rem] mx-auto px-5 sm:px-8 min-h-16 py-2 flex items-center justify-between gap-x-4 sm:gap-x-8"
      >
        <a href="/" class="flex items-center gap-3 whitespace-nowrap">
          <span class="mark" aria-hidden="true"></span>
          <span class="display text-[1.45rem] leading-none">bottega-kit</span>
          <span
            class="font-mono text-[0.7rem] text-[var(--color-cream-soft)] border border-[var(--color-line)] px-1.5 py-0.5 leading-none"
            >v{kit.version}</span
          >
        </a>
        <ul
          class="hidden md:flex flex-wrap justify-end gap-x-5 gap-y-1 font-mono text-[0.8rem] tracking-wide text-[var(--color-cream-soft)]"
        >
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class={navLink}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <details class="relative md:hidden" data-mobile-menu>
          <summary class="cursor-pointer min-h-11 py-3 px-3 border border-[var(--color-line-strong)] font-mono text-sm">Menu</summary>
          <ul class="absolute z-30 right-0 top-full mt-2 min-w-40 border border-[var(--color-line-strong)] bg-[var(--color-soot)] p-2 font-mono text-sm">
            {nav.map((item) => (
              <li><a href={item.href} class:list={[navLink, 'block px-3 py-3']}>{item.label}</a></li>
            ))}
          </ul>
        </details>
      </nav>
    </header>

    <main id="main" class:list={[isDoc ? 'doc max-w-[76rem] mx-auto px-5 sm:px-8 py-12' : '']}>
      <slot />
    </main>

    <footer class="border-t border-[var(--color-line)]">
      <div
        class="max-w-[76rem] mx-auto px-5 sm:px-8 py-8 font-mono text-[0.8rem] text-[var(--color-cream-soft)] flex flex-col sm:flex-row justify-between gap-3"
      >
        <span>
          <a href="https://opensource.org/licenses/MIT" class={navLink}>MIT</a>
          <span aria-hidden="true"> · </span>
          <a href="/privacy/" class={navLink}>Privacy</a>
          <span aria-hidden="true"> · </span>
          <a href="https://github.com/reasance/bottega-kit" class={navLink} rel="noopener">GitHub</a
          >
          <span aria-hidden="true"> · </span>
          <a href="/changelog/" class={navLink}>Changelog</a>
        </span>
        <span>
          <a href={kit.releaseUrl} class={navLink} rel="noopener">bottega-kit {kit.version}</a>
          · {kit.releaseDate}
        </span>
      </div>
    </footer>

    <script>
      const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      menu?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
      });
      menu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
