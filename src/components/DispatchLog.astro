---
// What `bottega plan` and `bottega run` print: one line per dispatch, the
// sequence number, the role, the profile, the model the harness reported,
// the result and the duration. The result is coloured as the signal is.
interface Line {
  seq: string;
  role: string;
  profile: string;
  model: string;
  result: string;
  time: string;
}
interface Props {
  lines: Line[];
  label?: string;
}
const { lines, label } = Astro.props;
const tone = (result: string) =>
  result === 'ready'
    ? 'text-[var(--color-ready-on-ink)]'
    : result === 'needs-work'
      ? 'text-[var(--color-work-on-ink)]'
      : result === 'blocked' || result.startsWith('stopped')
        ? 'text-[var(--color-blocked-on-ink)]'
        : 'text-[var(--color-paper)]';
---

<figure class="min-w-0">
  {label && <figcaption class="mb-2 font-mono text-[0.75rem] text-[var(--color-ink-soft)]">{label}</figcaption>}
  <pre
    class="bg-[var(--color-ink)] text-[var(--color-paper)] px-4 py-3 overflow-x-auto text-[0.85rem] leading-relaxed w-full"><code>{lines.map((l) => (
      <span class="block"><span class="text-[var(--color-line)]">{l.seq}</span> {l.role.padEnd(11)} {l.profile.padEnd(13)} <span class="text-[var(--color-line)]">{l.model.padEnd(18)}</span>→ <span class={tone(l.result)}>{l.result}</span> <span class="text-[var(--color-line)]">({l.time})</span></span>
    ))}</code></pre>
</figure>
