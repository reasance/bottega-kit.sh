{
  // Cloudflare Workers with Static Assets: the built site in dist/ is served
  // by the platform, with no Worker script of our own. `npm run build` first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bottega-kit-sh",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Served at https://bottega-kit.sh, and at www.bottega-kit.sh with the
  // same content (the canonical link names the apex). The zone is on this
  // Cloudflare account; wrangler creates the DNS records and certificates.
  "routes": [
    { "pattern": "bottega-kit.sh", "custom_domain": true },
    { "pattern": "www.bottega-kit.sh", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
