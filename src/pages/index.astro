---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Inline from '../components/Inline.astro';
import Transcript from '../components/Transcript.astro';
import type { Line } from '../components/Transcript.astro';
import LoopDiagram from '../components/LoopDiagram.astro';
import kit from '../data/kit.json';
import copy from '../data/copy.json';

// The hand-written copy lives in src/data/copy.json. Its strings may hold
// `code` and *emphasis* (see Inline.astro) and these placeholders, filled
// from the kit's own tables so no number is typed by hand:
const values: Record<string, string | number> = {
  rounds: kit.defaultRounds,
  exitOk: kit.exitCodes.ok,
  exitRefused: kit.exitCodes.refused,
  exitStopped: kit.exitCodes.stopped,
  proxyStripped: kit.proxyStripped.length,
  version: kit.version
};
const t = (s: string) => s.replace(/\{(\w+)\}/g, (m, k) => (k in values ? String(values[k]) : m));

// The starter configuration, as `bottega init` writes it when it finds both
// CLIs, in the README's one-profile-per-line shape.
const spaced = (value: unknown) =>
  JSON.stringify(value).replace(/,"/g, ', "').replace(/":/g, '": ');
const config = `{
  "schema_version": ${kit.starter.schema_version},
  "profiles": {
${Object.entries(kit.starter.profiles)
  .map(([name, profile]) => `    ${JSON.stringify(name).padEnd(16)} ${spaced(profile)}`)
  .join(',\n')}
  },
  "roles": ${spaced(kit.starter.roles)},
  "rounds": ${kit.starter.rounds}
}`;

// One argv per harness, as HARNESS_MATRIX has it, with shell quoting for the
// arguments that need it.
const quote = (arg: string) => (/^[A-Za-z0-9_@%+=:,./<>-]+$/.test(arg) ? arg : `'${arg}'`);
const argv = (harness: 'claude' | 'codex', role: 'implementer' | 'reviewer') =>
  kit.matrix[harness][role].map(quote).join(' ');

// The README's run, as the terminal shows it: `plan`, `approve`, `run`, `pr`,
// or only `run` and `pr` when the copy asks for the short form.
const task = '20261017-0930-add-a-dry-run-flag';
const planLines: Line[] = [
  { cmd: 'bottega plan dry-run-flag' },
  {
    dispatch: {
      seq: '001',
      role: 'planner',
      profile: 'fable',
      model: 'claude-fable-5-1',
      result: 'planned',
      time: '2m41s'
    }
  },
  { cmd: 'bottega approve dry-run-flag' },
  { out: `approved ${task}` },
  { out: '  planner     fable (claude, claude-fable-5-1, effort max)' },
  { out: '  implementer opus-builder (claude, claude-opus-5-5, effort high)' },
  { out: '  reviewer    opus-reviewer (claude, claude-opus-5-5, effort high)' },
  { out: '  judge       fable (claude, claude-fable-5-1, effort max)' },
  { out: `rounds    ${kit.defaultRounds}` },
  { out: 'plan      sha256 9c1e4b7d02aa' },
  { out: 'to-do     7 item(s), T1..T7; 7 new id(s)' },
  { out: `next: bottega run ${task}` }
];
const runLines: Line[] = [
  { cmd: 'bottega run dry-run-flag' },
  {
    dispatch: {
      seq: '002',
      role: 'implementer',
      profile: 'opus-builder',
      model: 'claude-opus-5-5',
      result: 'done',
      time: '6m02s'
    }
  },
  {
    dispatch: {
      seq: '003',
      role: 'reviewer',
      profile: 'opus-reviewer',
      model: 'claude-opus-5-5',
      result: 'needs-work',
      time: '2m14s'
    }
  },
  {
    dispatch: {
      seq: '004',
      role: 'implementer',
      profile: 'opus-builder',
      model: 'claude-opus-5-5',
      result: 'done',
      time: '3m40s'
    }
  },
  {
    dispatch: {
      seq: '005',
      role: 'reviewer',
      profile: 'opus-reviewer',
      model: 'claude-opus-5-5',
      result: 'ready',
      time: '1m55s'
    }
  },
  {
    dispatch: {
      seq: '006',
      role: 'judge',
      profile: 'fable',
      model: 'claude-fable-5-1',
      result: 'ready',
      time: '48s'
    }
  },
  { cmd: 'bottega pr dry-run-flag' },
  { out: 'https://github.com/you/your-repo/pull/42' }
];
const transcript = copy.hero.transcript === 'full' ? [...planLines, ...runLines] : runLines;

const statusClass: Record<string, string> = {
  ready: 'status status-ready',
  'needs-work': 'status status-work',
  blocked: 'status status-blocked'
};
const ruleStatus: Record<string, string> = {
  'dispatch-failed': 'status-blocked',
  'identity-mismatch': 'status-blocked',
  'role-modified-worktree': 'status-blocked',
  'implementer done': 'status-ready',
  'reviewer signals': 'status-work',
  'judge signals': 'status-ready'
};
const roleSignals: Record<string, string[]> = {
  planner: [],
  implementer: [],
  reviewer: ['ready', 'needs-work', 'blocked'],
  judge: ['ready', 'needs-work']
};

const wrap = 'max-w-[76rem] mx-auto px-5 sm:px-8';
const ledger = 'grid gap-y-6 lg:grid-cols-[8rem_minmax(0,1fr)] lg:gap-x-12';
const h2 = 'text-[2.3rem] md:text-[3.1rem] [text-wrap:balance] mb-4';
const lead = 'text-lg text-[var(--color-cream-soft)] max-w-2xl';
const soft = 'text-[var(--color-cream-soft)]';
const label = 'font-mono text-[0.72rem] tracking-wide uppercase text-[var(--color-cream-soft)]';
---

<BaseLayout path="/">
  <!-- Hero -->
  <section class={`${wrap} pt-14 pb-16 md:pt-24 md:pb-20`}>
    <p class="eyebrow mb-8">{t(copy.hero.eyebrow)}</p>
    <h1 class="text-[3.1rem] sm:text-[4rem] md:text-[5.2rem] xl:text-[6rem] [text-wrap:balance]">
      {
        copy.hero.h1.map((line) => (
          <span class="block">
            <Inline text={t(line)} />
          </span>
        ))
      }
    </h1>
    <p
      class="mt-9 max-w-2xl text-lg md:text-[1.3rem] md:leading-[1.5] text-[var(--color-cream-soft)]"
    >
      <Inline text={t(copy.hero.lead)} />
    </p>
    <p class="mt-9 flex flex-wrap items-center gap-3">
      <a href="/docs/" class="btn">{copy.hero.cta}</a>
      <a href="#transcript" class="btn btn-ghost">{copy.hero.cta2}</a>
    </p>
    <div id="transcript" class="mt-16 max-w-3xl scroll-mt-6">
      <Transcript lines={transcript} label={t(copy.hero.transcriptCaption)} />
    </div>
  </section>

  <!-- 01 · the commands -->
  <section id="commands" class="band scroll-mt-4">
    <div class={`${wrap} py-16 md:py-20`}>
      <div class={ledger}>
        <div>
          <p class="idx">01</p>
          <p class="eyebrow mt-1">Six commands</p>
        </div>
        <div>
          <h2 class={h2}><Inline text={t(copy.commands.h2)} /></h2>
          <p class="text-lg text-[var(--color-ink-soft)] max-w-2xl mb-12">
            <Inline text={t(copy.commands.lead)} />
          </p>
          <ol class="grid gap-x-8 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
            {
              copy.commands.items.map((c) => {
                const you = c.cmd === 'approve';
                return (
                  <li
                    class:list={[
                      'border-t pt-4',
                      you ? 'border-[var(--color-you-ink)]' : 'border-[var(--color-ink)]'
                    ]}
                  >
                    <p class="font-mono text-[1.35rem] leading-none mb-3">
                      bottega{' '}
                      <span class:list={[you && 'text-[var(--color-you-ink)]']}>{c.cmd}</span>
                      {you && (
                        <span class="status status-you ml-2 align-middle">the human gate</span>
                      )}
                    </p>
                    <p class="text-[var(--color-ink-soft)] text-[0.95rem]">
                      <Inline text={t(c.what)} />
                    </p>
                  </li>
                );
              })
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · what you can count on -->
  <section id="rules" class="scroll-mt-4">
    <div class={`${wrap} py-16 md:py-20`}>
      <div class={ledger}>
        <div>
          <p class="idx">02</p>
          <p class="eyebrow mt-1">The rules</p>
        </div>
        <div>
          <h2 class={h2}><Inline text={t(copy.claims.h2)} /></h2>
          <p class={`${lead} mb-12`}><Inline text={t(copy.claims.lead)} /></p>
          <ul class="grid gap-x-10 gap-y-10 md:grid-cols-2">
            {
              copy.claims.items.map((c) => (
                <li class="border-t border-[var(--color-line)] pt-5">
                  <h3 class="text-[1.75rem] md:text-[2rem] mb-3 [text-wrap:balance]">
                    <Inline text={t(c.title)} />
                  </h3>
                  <p class={soft}>
                    <Inline text={t(c.text)} />
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · how a task runs -->
  <section id="loop" class="sec scroll-mt-4">
    <div class={`${wrap} py-16 md:py-20`}>
      <div class={ledger}>
        <div>
          <p class="idx">03</p>
          <p class="eyebrow mt-1">The loop</p>
        </div>
        <div>
          <h2 class={h2}><Inline text={t(copy.loop.h2)} /></h2>
          <p class={`${lead} mb-12`}><Inline text={t(copy.loop.lead)} /></p>
          <div
            class="mb-12 hidden sm:block border border-[var(--color-line)] bg-[var(--color-coal)] p-4 md:p-6"
          >
            <LoopDiagram />
          </div>
          <ol class="grid gap-x-8 gap-y-6 md:grid-cols-2 xl:grid-cols-3">
            {
              copy.loop.rules.map((r) => (
                <li class="border-t border-[var(--color-line)] pt-3">
                  <span class={`status ${ruleStatus[r.word] ?? 'status-ready'}`}>{r.word}</span>
                  <p class={`mt-2 text-[0.95rem] ${soft}`}>
                    <Inline text={t(r.text)} />
                  </p>
                </li>
              ))
            }
          </ol>
          <p class={`mt-12 ${soft} max-w-2xl`}>
            <Inline text={t(copy.loop.after)} />
            <a href="/docs/process/" class="lnk">{copy.loop.afterLink}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · the roles -->
  <section
    id="roles"
    class="bg-[var(--color-coal)] border-t border-[var(--color-line)] scroll-mt-4"
  >
    <div class={`${wrap} py-16 md:py-20`}>
      <div class={ledger}>
        <div>
          <p class="idx">04</p>
          <p class="eyebrow mt-1">The roles</p>
        </div>
        <div>
          <h2 class={h2}><Inline text={t(copy.roles.h2)} /></h2>
          <p class={`${lead} mb-12`}><Inline text={t(copy.roles.lead)} /></p>
          <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 xl:grid-cols-4">
            {
              copy.roles.items.map((r, i) => (
                <li class="border-t border-[var(--color-line-strong)] pt-4 flex flex-col gap-3">
                  <p class="display text-[3rem] leading-none text-[var(--color-cream-soft)]">
                    {i + 1}
                  </p>
                  <p class="font-mono text-[1.2rem]">{r.role}</p>
                  <p class={soft}>
                    <Inline text={t(r.does)} />
                  </p>
                  <p>
                    <span class={label}>may change</span>
                    <br />
                    <span class={`text-[0.95rem] ${soft}`}>
                      <Inline text={t(r.changes)} />
                    </span>
                  </p>
                  <p>
                    <span class={label}>its product</span>
                    <br />
                    <span class={`text-[0.95rem] ${soft}`}>
                      <Inline text={t(r.product)} />
                    </span>
                  </p>
                  <p class="mt-auto pt-1 flex flex-wrap gap-x-3 gap-y-1">
                    {(roleSignals[r.role] ?? []).length ? (
                      roleSignals[r.role].map((s) => <span class={statusClass[s]}>{s}</span>)
                    ) : (
                      <span class={label}>no signal</span>
                    )}
                  </p>
                </li>
              ))
            }
          </ol>

          <div class="mt-16 grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-10">
            <div>
              <h3 class="text-[1.75rem] md:text-[2rem] mb-3">
                <Inline text={t(copy.roles.bindH3)} />
              </h3>
              <p class={soft}>
                <Inline text={t(copy.roles.bindText)} />
                <a href="/docs/configuration/" class="lnk">{copy.roles.bindLink}</a>
              </p>
            </div>
            <CodeBlock lang="json" label="~/.config/bottega-kit/config.json" code={config} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 · the harnesses -->
  <section id="harnesses" class="sec scroll-mt-4">
    <div class={`${wrap} py-16 md:py-20`}>
      <div class={ledger}>
        <div>
          <p class="idx">05</p>
          <p class="eyebrow mt-1">The harnesses</p>
        </div>
        <div>
          <h2 class={h2}><Inline text={t(copy.harnesses.h2)} /></h2>
          <p class={`${lead} mb-12`}><Inline text={t(copy.harnesses.lead)} /></p>
          <div class="grid gap-10 lg:grid-cols-2">
            <div class="min-w-0">
              <h3 class="font-mono text-[1.2rem] mb-3">claude</h3>
              <p class={`${soft} mb-5`}>
                <Inline text={t(copy.harnesses.claude)} />
                Effort <span class="font-mono text-[0.85em]">{kit.efforts.claude.join(' · ')}</span
                >.
              </p>
              <CodeBlock label="implementer" wrap code={argv('claude', 'implementer')} />
            </div>
            <div class="min-w-0">
              <h3 class="font-mono text-[1.2rem] mb-3">codex</h3>
              <p class={`${soft} mb-5`}>
                <Inline text={t(copy.harnesses.codex)} />
                Effort <span class="font-mono text-[0.85em]">{kit.efforts.codex.join(' · ')}</span>.
              </p>
              <CodeBlock label="implementer" wrap code={argv('codex', 'implementer')} />
            </div>
          </div>
          <p class={`mt-12 ${soft} max-w-2xl`}>
            <Inline text={t(copy.harnesses.after)} />
            <a href="/docs/compatibility/" class="lnk">{t(copy.harnesses.afterLink)}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · the receipt -->
  <section id="receipt" class="sec scroll-mt-4">
    <div class={`${wrap} py-16 md:py-20`}>
      <div class={ledger}>
        <div>
          <p class="idx">06</p>
          <p class="eyebrow mt-1">The receipt</p>
        </div>
        <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
          <div>
            <h2 class="text-[2.3rem] md:text-[2.8rem] [text-wrap:balance] mb-4">
              <Inline text={t(copy.receipt.h2)} />
            </h2>
            <p class={soft}>
              <Inline text={t(copy.receipt.text)} />
            </p>
          </div>
          <ul class="border-b border-[var(--color-line)] self-start">
            {
              copy.receipt.items.map((r) => (
                <li class="border-t border-[var(--color-line)] py-3 grid grid-cols-[8.5rem_1fr] gap-4">
                  <span class="font-mono text-[0.85rem] pt-0.5">{r.file}</span>
                  <span class={soft}>
                    <Inline text={t(r.what)} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- install -->
  <section id="install" class="band scroll-mt-4">
    <div class={`${wrap} py-16 md:py-24`}>
      <div class={ledger}>
        <div>
          <p class="idx">07</p>
          <p class="eyebrow mt-1">Install</p>
        </div>
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16 items-start">
          <div>
            <h2 class={h2}><Inline text={t(copy.install.h2)} /></h2>
            <p class="text-lg text-[var(--color-ink-soft)] max-w-xl">
              <Inline text={t(copy.install.text)} />
            </p>
            <p class="mt-8 flex flex-wrap gap-3">
              <a href="/docs/" class="btn">{copy.install.cta}</a>
              <a href="/docs/process/" class="btn btn-ghost">{copy.install.cta2}</a>
              <a href="/changelog/" class="btn btn-ghost">{copy.install.cta3}</a>
            </p>
          </div>
          <CodeBlock
            label="Terminal"
            code={`npx bottega-kit
bottega init
bottega doctor`}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
